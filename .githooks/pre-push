#!/bin/bash
# Pre-push hook: Run linting and formatting checks before push
# Prevents pushing code that fails quality checks

set -e

echo "🔍 Running pre-push checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}✗ Not in a git repository${NC}"
    exit 1
fi

# Get the branch being pushed
while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Branch is being deleted, skip checks
        continue
    fi

    branch=$(echo $remote_ref | sed 's/refs\/heads\///')
    echo -e "${YELLOW}📝 Pushing branch: $branch${NC}"
    echo ""
done

# Step 1: Run linting checks
echo "Step 1/4: Running linting checks..."
echo "--------------------------------------"

# Store initial git status
git_status_before=$(git status --porcelain)

if ! docker compose -f docker-compose.test.yaml --profile lint up --build --abort-on-container-exit --exit-code-from lint-runner 2>&1 | tail -20; then
    echo ""
    echo -e "${RED}✗ Linting failed!${NC}"
    echo -e "${RED}Fix linting errors before pushing.${NC}"
    echo ""
    echo "To fix formatting issues, run:"
    echo "  docker compose -f docker-compose.test.yaml --profile lint up --build"
    echo ""
    exit 1
fi

# Check if linters auto-fixed any files
git_status_after=$(git status --porcelain)

if [ "$git_status_before" != "$git_status_after" ]; then
    echo ""
    echo -e "${YELLOW}⚠ Auto-formatters modified files. Auto-committing...${NC}"

    # Stage all modified files
    git add -u

    # Amend the last commit with auto-fixes
    git commit --amend --no-edit --no-verify

    echo -e "${GREEN}✓ Auto-formatted files committed${NC}"
    echo ""
fi

echo ""
echo -e "${GREEN}✓ Linting passed${NC}"
echo ""

# Step 2: Run frontend unit tests
echo "Step 2/4: Running frontend unit tests..."
echo "--------------------------------------"

if ! docker compose -f docker-compose.test.yaml --profile ui up --build --abort-on-container-exit --exit-code-from ui-runner 2>&1 | tail -20; then
    echo ""
    echo -e "${RED}✗ Frontend tests failed!${NC}"
    echo -e "${RED}Fix frontend test failures before pushing.${NC}"
    echo ""
    exit 1
fi

echo ""
echo -e "${GREEN}✓ Frontend tests passed${NC}"
echo ""

# Step 3: Run backend unit + integration tests
echo "Step 3/4: Running backend unit & integration tests..."
echo "--------------------------------------"

if ! docker compose -f docker-compose.test.yaml --profile unit up --build --abort-on-container-exit --exit-code-from test-runner 2>&1 | tail -20; then
    echo ""
    echo -e "${RED}✗ Backend tests failed!${NC}"
    echo -e "${RED}Fix backend test failures before pushing.${NC}"
    echo ""
    exit 1
fi

echo ""
echo -e "${GREEN}✓ Backend tests passed${NC}"
echo ""

# Step 4: Quick sanity check - ensure critical files exist
echo "Step 4/4: Sanity checks..."
echo "--------------------------------------"

critical_files=(
    "squid_proxy_manager/config.yaml"
    "squid_proxy_manager/Dockerfile"
    "squid_proxy_manager/frontend/package.json"
    "squid_proxy_manager/rootfs/app/main.py"
)

for file in "${critical_files[@]}"; do
    if [ ! -f "$file" ]; then
        echo -e "${RED}✗ Critical file missing: $file${NC}"
        exit 1
    fi
done

echo -e "${GREEN}✓ All critical files present${NC}"
echo ""

# All checks passed
echo "======================================"
echo -e "${GREEN}✓ All pre-push checks passed!${NC}"
echo "======================================"
echo ""

exit 0
